{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "GPU utilisation (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "llm_gpu_utilization_percent",
          "legendFormat": "GPU {{gpu}} {{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "VRAM used (GiB)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "llm_gpu_memory_used_bytes / 1024^3",
          "legendFormat": "GPU {{gpu}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "GiB", "min": 0 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Ollama API",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "llm_ollama_up", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Loaded models",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "llm_ollama_loaded_models", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "GPU temperature / power",
      "gridPos": { "h": 8, "w": 12, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "llm_gpu_temperature_celsius", "legendFormat": "temp °C", "refId": "A" },
        { "expr": "llm_gpu_power_watts", "legendFormat": "power W", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host CPU / RAM",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "llm_host_cpu_percent", "legendFormat": "CPU %", "refId": "A" },
        { "expr": "100 * llm_host_memory_used_bytes / llm_host_memory_total_bytes", "legendFormat": "RAM %", "refId": "B" }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["llm", "redteam", "owasp"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "title": "Llama-Sahabat Redteam · LLM Engine",
  "uid": "llm-redteam-engine",
  "version": 1
}
